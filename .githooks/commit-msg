#!/bin/sh
set -eu

commit_msg_file="$1"
header=$(sed -n '1p' "$commit_msg_file")

if ! printf '%s\n' "$header" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]./_-]+\))?!?: .+'; then
  printf '%s\n' "Invalid commit message: $header" >&2
  printf '%s\n' "Use: type(scope): short description" >&2
  printf '%s\n' "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  exit 1
fi

if [ "${#header}" -gt 100 ]; then
  printf '%s\n' "Commit subject must be 100 characters or fewer." >&2
  exit 1
fi
